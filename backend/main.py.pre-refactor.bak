@app.post("/admin/catalog/import-mca")
def import_mca_catalog(admin: dict[str, Any] = Depends(require_role("admin"))) -> dict[str, Any]:
    """Idempotently import the MCA catalog transcribed from the admin-provided course list."""
    new_accounts: list[dict[str, str]] = []
    reused_faculty: set[str] = set()
    faculty_ids: dict[str, int] = {}
    subject_ids: dict[str, int] = {}
    subjects_created = 0
    subjects_updated = 0
    assignments_created = 0
    try:
        with engine.begin() as connection:
            course = connection.execute(text("SELECT id, name FROM courses WHERE UPPER(code) = 'MCA' ORDER BY id LIMIT 1 FOR UPDATE")).mappings().first()
            if course is None:
                course = connection.execute(text("""
                    INSERT INTO courses (name, code, description)
                    VALUES ('MCA', 'MCA', 'Master of Computer Applications')
                    RETURNING id, name
                """)).mappings().one()
            course_id = int(course["id"])

            for _, _, _, _, _, faculty_name in MCA_CATALOG_IMPORT:
                if faculty_name in faculty_ids:
                    continue
                existing = connection.execute(text("""
                    SELECT id FROM users
                    WHERE role = 'faculty' AND LOWER(full_name) = LOWER(:full_name)
                    ORDER BY id LIMIT 1
                """), {"full_name": faculty_name}).scalar_one_or_none()
                if existing is not None:
                    faculty_ids[faculty_name] = int(existing)
                    reused_faculty.add(faculty_name)
                    continue

                base_username = re.sub(r"[^a-z0-9]+", ".", faculty_name.casefold()).strip(".") or "faculty"
                username = base_username[:80]
                suffix = 1
                while connection.execute(text("SELECT 1 FROM users WHERE LOWER(username) = LOWER(:username) OR LOWER(email) = LOWER(:email)"), {
                    "username": username,
                    "email": f"{username}@faculty.example.invalid",
                }).first() is not None:
                    tail = f".{suffix}"
                    username = f"{base_username[:80 - len(tail)]}{tail}"
                    suffix += 1
                email = f"{username}@faculty.example.invalid"
                initial_password = re.sub(r"[^A-Za-z0-9]", "", faculty_name) + "1234"
                row = connection.execute(text("""
                    INSERT INTO users (username, email, full_name, password_hash, role)
                    VALUES (:username, :email, :full_name, :password_hash, 'faculty')
                    RETURNING id
                """), {
                    "username": username,
                    "email": email,
                    "full_name": faculty_name,
                    "password_hash": password_hasher.hash(initial_password),
                }).mappings().one()
                faculty_ids[faculty_name] = int(row["id"])
                new_accounts.append({
                    "full_name": faculty_name,
                    "username": username,
                    "email": email,
                    "initial_password": initial_password,
                })

            for code, name, term, semester, section, faculty_name in MCA_CATALOG_IMPORT:
                subject = connection.execute(text("""
                    SELECT id FROM subjects WHERE UPPER(code) = UPPER(:code)
                    ORDER BY id LIMIT 1 FOR UPDATE
                """), {"code": code}).scalar_one_or_none()
                values = {
                    "course_id": course_id,
                    "code": code,
                    "name": name,
                    "semester": semester,
                    "term": term,
                    "instructor_name": faculty_name,
                    "section": section,
                }
                if subject is None:
                    subject_id = connection.execute(text("""
                        INSERT INTO subjects (course_id, code, name, semester, term, instructor_name, section)
                        VALUES (:course_id, :code, :name, :semester, :term, :instructor_name, :section)
                        RETURNING id
                    """), values).scalar_one()
                    subjects_created += 1
                else:
                    subject_id = connection.execute(text("""
                        UPDATE subjects
                        SET course_id = :course_id, name = :name, semester = :semester,
                            term = :term, instructor_name = :instructor_name, section = :section
                        WHERE id = :subject_id
                        RETURNING id
                    """), {**values, "subject_id": subject}).scalar_one()
                    subjects_updated += 1
                subject_ids[code] = int(subject_id)

                assignment_id = connection.execute(text("""
                    INSERT INTO faculty_subject_assignments (faculty_user_id, subject_id, assigned_by)
                    VALUES (:faculty_id, :subject_id, :admin_id)
                    ON CONFLICT (faculty_user_id, subject_id) DO NOTHING
                    RETURNING id
                """), {
                    "faculty_id": faculty_ids[faculty_name],
                    "subject_id": subject_id,
                    "admin_id": admin["id"],
                }).scalar_one_or_none()
                if assignment_id is not None:
                    assignments_created += 1
    except IntegrityError as error:
        raise HTTPException(status_code=409, detail="The MCA catalog import conflicted with existing account or catalog data; no changes were saved.") from error

    return {
        "course": {"id": course_id, "name": course["name"], "code": "MCA"},
        "subjects_total": len(MCA_CATALOG_IMPORT),
        "subjects_created": subjects_created,
        "subjects_updated": subjects_updated,
        "faculty_accounts_created": len(new_accounts),
        "faculty_accounts_reused": len(reused_faculty),
        "faculty_assignments_created": assignments_created,
        "existing_faculty": sorted(reused_faculty),
        "new_faculty_accounts": new_accounts,
        "email_note": "Generated addresses use the reserved .invalid domain and are placeholders; replace them with official emails before real use.",
        "password_note": "Initial passwords follow the requested name + 1234 pattern. They are demo-only and should be changed before real use.",
    }


@app.get("/admin/users")
def list_users(
    search: str | None = None,
    role: Literal["student", "faculty", "admin"] | None = None,
    limit: int = 25,
    offset: int = 0,
    _admin: dict[str, Any] = Depends(require_role("admin")),
) -> dict[str, Any]:
    limit = max(1, min(limit, 100))
    offset = max(0, offset)
    with engine.connect() as connection:
        conditions = []
        params: dict[str, Any] = {"limit": limit, "offset": offset}
        if role:
            conditions.append("role = :role")
            params["role"] = role
        if search and search.strip():
            conditions.append("(username ILIKE :search OR email ILIKE :search OR full_name ILIKE :search)")
            params["search"] = f"%{search.strip()}%"
        where = " WHERE " + " AND ".join(conditions) if conditions else ""
        total = connection.execute(text(f"SELECT COUNT(*) FROM users{where}"), params).scalar_one()
        users = connection.execute(
            text(f"""
                SELECT id, username, email, full_name, role, created_at
                FROM users{where}
                ORDER BY created_at DESC, id DESC
                LIMIT :limit OFFSET :offset
            """)
            , params
        ).mappings().all()
    return {"users": [dict(user) for user in users], "total": total, "limit": limit, "offset": offset}


@app.get("/admin/faculty")
def list_faculty(
    search: str | None = None,
    limit: int = 25,
    offset: int = 0,
    _admin: dict[str, Any] = Depends(require_role("admin")),
) -> dict[str, Any]:
    limit = max(1, min(limit, 100))
    offset = max(0, offset)
    with engine.connect() as connection:
        params: dict[str, Any] = {"limit": limit, "offset": offset}
        filter_sql = ""
        if search and search.strip():
            filter_sql = " AND (username ILIKE :search OR email ILIKE :search OR full_name ILIKE :search)"
            params["search"] = f"%{search.strip()}%"
        total = connection.execute(text("SELECT COUNT(*) FROM users WHERE role = 'faculty'" + filter_sql), params).scalar_one()
        rows = connection.execute(text("""
            SELECT id, username, email, full_name, created_at
            FROM users WHERE role = 'faculty'
        """ + filter_sql + """
            ORDER BY full_name, id
            LIMIT :limit OFFSET :offset
        """), params).mappings().all()
        instructors = connection.execute(text("""
            SELECT s.instructor_name AS full_name,
                   array_agg(DISTINCT s.name ORDER BY s.name) AS subjects,
                   EXISTS (
                       SELECT 1 FROM users AS u
                       WHERE u.role = 'faculty'
                         AND LOWER(TRIM(u.full_name)) = LOWER(TRIM(s.instructor_name))
                   ) AS has_login
            FROM subjects AS s
            WHERE s.instructor_name IS NOT NULL AND TRIM(s.instructor_name) <> ''
            GROUP BY s.instructor_name
            ORDER BY s.instructor_name
        """)).mappings().all()
    return {
        "faculty": [dict(row) for row in rows],
        "course_instructors": [dict(row) for row in instructors],
        "total": total,
        "limit": limit,
        "offset": offset,
    }


@app.post("/admin/faculty", status_code=201)
def create_faculty(
    faculty: FacultyCreate,
    _admin: dict[str, Any] = Depends(require_role("admin")),
) -> dict[str, Any]:
    try:
        with engine.begin() as connection:
            row = connection.execute(text("""
                INSERT INTO users (username, email, full_name, password_hash, role)
                VALUES (:username, :email, :full_name, :password_hash, 'faculty')
                RETURNING id, username, email, full_name, role, created_at
            """), {
                "username": faculty.username.strip(),
                "email": faculty.email.strip(),
                "full_name": faculty.full_name.strip(),
                "password_hash": password_hasher.hash(faculty.password),
            }).mappings().one()
    except IntegrityError as error:
        raise HTTPException(status_code=409, detail="That username or email is already registered.") from error
    return dict(row)


@app.patch("/admin/faculty/{faculty_id}")
def update_faculty(
    faculty_id: int,
    changes: FacultyUpdate,
    _admin: dict[str, Any] = Depends(require_role("admin")),
) -> dict[str, Any]:
    values = changes.model_dump(exclude_unset=True)
    if not values:
        raise HTTPException(status_code=422, detail="Enter at least one field to update.")
    values = {key: value.strip() if value is not None else value for key, value in values.items()}
    fields = ", ".join(f"{key} = :{key}" for key in values)
    try:
        with engine.begin() as connection:
            row = connection.execute(text(f"""
                UPDATE users SET {fields}
                WHERE id = :faculty_id AND role = 'faculty'
                RETURNING id, username, email, full_name, role, created_at
            """), {**values, "faculty_id": faculty_id}).mappings().one_or_none()
    except IntegrityError as error:
        raise HTTPException(status_code=409, detail="That username or email is already in use.") from error
    if row is None:
        raise HTTPException(status_code=404, detail="Faculty account not found.")
    return dict(row)


@app.delete("/admin/faculty/{faculty_id}")
def delete_faculty(
    faculty_id: int,
    _admin: dict[str, Any] = Depends(require_role("admin")),
) -> dict[str, str]:
    try:
        with engine.begin() as connection:
            deleted_id = connection.execute(text("""
                DELETE FROM users WHERE id = :faculty_id AND role = 'faculty'
                RETURNING id
            """), {"faculty_id": faculty_id}).scalar_one_or_none()
    except IntegrityError as error:
        raise HTTPException(status_code=409, detail="This faculty account is linked to existing records and cannot be removed yet.") from error
    if deleted_id is None:
        raise HTTPException(status_code=404, detail="Faculty account not found.")
    return {"message": "Faculty account removed."}


@app.get("/faculty/students")
def list_students(
    subject_id: int | None = None,
    _faculty: dict[str, Any] = Depends(require_role("faculty")),
) -> dict[str, list[dict[str, Any]]]:
    subject_filter = ""
    params: dict[str, Any] = {"faculty_id": _faculty["id"]}
    if subject_id is not None:
        subject_filter = " AND e.subject_id = :subject_id"
        params["subject_id"] = subject_id
    with engine.connect() as connection:
        if subject_id is not None:
            assigned_subject = connection.execute(text("""
                SELECT 1 FROM faculty_subject_assignments
                WHERE faculty_user_id = :faculty_id AND subject_id = :subject_id
            """), params).scalar_one_or_none()
            if assigned_subject is None:
                raise HTTPException(status_code=403, detail="Choose a subject assigned to your faculty account.")
        students = connection.execute(
            text(f"""
                SELECT DISTINCT u.id, u.username, u.full_name
                FROM users u
                JOIN student_subject_enrollments e ON e.student_user_id = u.id
                JOIN faculty_subject_assignments a ON a.subject_id = e.subject_id
                WHERE u.role = 'student' AND a.faculty_user_id = :faculty_id
                  {subject_filter}
                ORDER BY u.full_name, u.id
            """), params,
        ).mappings().all()
    return {"students": [dict(student) for student in students]}

def _campus_local_datetime(value: datetime | None) -> datetime | None:
    if value is None or value.tzinfo is not None:
        return value
    # Browser datetime-local values are campus local time; Alliance is in India.
    return value.replace(tzinfo=timezone(timedelta(hours=5, minutes=30)))


@app.get("/events")
def list_campus_events(
    limit: int = Query(default=200, ge=1, le=500),
    _current_user: dict[str, Any] = Depends(get_current_user),
) -> dict[str, list[dict[str, Any]]]:
    with engine.connect() as connection:
        rows = connection.execute(text("""
            SELECT id, title, description, event_type, start_at, end_at, location
            FROM campus_events
            ORDER BY start_at, id
            LIMIT :limit
        """), {"limit": limit}).mappings().all()
    return {"events": [dict(row) for row in rows]}


@app.post("/admin/events", status_code=201)
def create_campus_event(
    event: CampusEventCreate,
    admin: dict[str, Any] = Depends(require_role("admin")),
) -> dict[str, Any]:
    start_at = _campus_local_datetime(event.start_at)
    end_at = _campus_local_datetime(event.end_at)
    if end_at and end_at < start_at:
        raise HTTPException(status_code=422, detail="The end time must be after the start time.")
    with engine.begin() as connection:
        row = connection.execute(text("""
            INSERT INTO campus_events (title, description, event_type, start_at, end_at, location, created_by)
            VALUES (:title, :description, :event_type, :start_at, :end_at, :location, :created_by)
            RETURNING id, title, description, event_type, start_at, end_at, location
        """), {
            "title": event.title.strip(),
            "description": event.description.strip() if event.description and event.description.strip() else None,
            "event_type": event.event_type,
            "start_at": start_at,
            "end_at": end_at,
            "location": event.location.strip() if event.location and event.location.strip() else None,
            "created_by": admin["id"],
        }).mappings().one()
    return dict(row)


@app.patch("/admin/events/{event_id}")
def update_campus_event(
    event_id: int,
    event: CampusEventCreate,
    _admin: dict[str, Any] = Depends(require_role("admin")),
) -> dict[str, Any]:
    start_at = _campus_local_datetime(event.start_at)
    end_at = _campus_local_datetime(event.end_at)
    if end_at and end_at < start_at:
        raise HTTPException(status_code=422, detail="The end time must be after the start time.")
    with engine.begin() as connection:
        row = connection.execute(text("""
            UPDATE campus_events
            SET title = :title, description = :description, event_type = :event_type,
                start_at = :start_at, end_at = :end_at, location = :location, updated_at = NOW()
            WHERE id = :event_id
            RETURNING id, title, description, event_type, start_at, end_at, location
        """), {
            "event_id": event_id,
            "title": event.title.strip(),
            "description": event.description.strip() if event.description and event.description.strip() else None,
            "event_type": event.event_type,
            "start_at": start_at,
            "end_at": end_at,
            "location": event.location.strip() if event.location and event.location.strip() else None,
        }).mappings().one_or_none()
    if row is None:
        raise HTTPException(status_code=404, detail="Event not found.")
    return dict(row)


